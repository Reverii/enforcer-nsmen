{
  "name": "enforcer-nsmen",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram Mini App for NSmen flying duty planning and SAF100 tracking",
  "scripts": {
    "test:rules": "node --test tests/rules.test.js tests/auth.test.js",
    "test:worker": "node --test tests/worker.test.js",
    "test:page": "node --test tests/page.test.js",
    "test": "npm run test:rules && npm run test:worker && npm run test:page",
    "dev": "wrangler dev --config worker/wrangler.toml",
    "deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "miniflare": "^4.20250501.0",
    "playwright": "^1.52.0",
    "wrangler": "^4.14.0"
  }
}
